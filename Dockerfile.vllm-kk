# karmic-kraken-beta (tip 2026-10-13) + 6-patch chain (individual diffs, no tarballs).
#
# Base pinned by immutable digest: ghcr.io/local-inference-lab/vllm
# :karmic-kraken-beta-20261013 (digest sha256:31d8ac21adb95359796d45455ba3d77a92e4b5d9455f091c1bd178e24f53370a,
# built from vllm 2e7b458480 = lil integration/karmic-kraken-beta tip —
# confirmed via in-image vllm/_version.py dev21826+g2e7b45848 and
# /opt/venv/share/lil-runtime/manifest.json; B12X now ships inside
# flashinfer 0.7.1 @ b4c35e6ec1 (flashinfer/experimental/b12x), no separate
# b12x wheel; lmcache_cumem 8ef537d6). Upstream tags no longer carry a hash
# suffix. The floating :karmic-kraken-beta tag is stale on this host —
# never build from it.
# Runtime stack (CUDA 13.4 / torch 2.14 nightly / python 3.12 / native
# extensions / venv layout / entrypoint / ENV) inherited unchanged.
#
# Patches apply as INDIVIDUAL format-patch diffs in lineage order onto the
# site-packages tree (paths repo-root-relative; tests/* excluded — not part
# of the installed package). A failure attributes to exactly one diff.
#
# Chain (branch kk-tip-20261013 on base 2e7b458480; exact shas in staged
# chain.txt, baked to /opt/venv/share/lil-runtime/chain.txt):
#   008 -> 001 -> 005 -> 009 -> 010 -> 011 (one port.diff each)
#
# Dropped from the kk-20260923 chain: 002/004 (already upstream at the old
# tip) and 003_01/003_02/003_03 (merged upstream as lil/vllm PRs #869 + #870,
# identical patch-ids) and 003_04 (superseded by upstream 212f46bfa8, which
# accepts --recurrent-checkpoint-policy aligned when the connector declares
# supports_aligned_hybrid_transfer and DCP == 1; OffloadingConnector does).
# Compose keeps --recurrent-checkpoint-policy aligned.
#
# Staged under files/vllm-kk/patches/kk/: the six bundle dirs above
# (port.diff + reference files), plus manifest.sha256 (per-file sha256 of
# every patched package file at chain head), version.txt (full version
# string), head.txt (40-hex chain head sha), chain.txt (sha + subject per
# commit, ordered).
#
# Build (offline, from compose project dir):
#   docker compose build vllm-kk                    # production
#   docker compose -f docker-compose.test.yml build # test rig

ARG BASE_IMAGE=ghcr.io/local-inference-lab/vllm@sha256:31d8ac21adb95359796d45455ba3d77a92e4b5d9455f091c1bd178e24f53370a
FROM ${BASE_IMAGE}

COPY files/vllm-kk/patches/kk/ /tmp/kk/

# Base authority guard: pinned base must not have moved under this recipe.
RUN set -eux; \
    test "$(sha256sum /opt/venv/lib/python3.12/site-packages/vllm/distributed/kv_transfer/kv_connector/v1/offloading/scheduler.py | cut -d' ' -f1)" = "ff03b452099d881141638e15c80f660168e920a81458715a365643251aa2703a"

# Apply the chain; each step is one named diff.
RUN set -eux; \
    cd /opt/venv/lib/python3.12/site-packages; \
    for d in 008-spec-invalid-tail-metrics 001-clamp_max_tokens \
             005-qwen-rope-config-validation 009-prefill-lane-release-aging \
             010-sched-second-pass-preempt 011-lane-share-align-quantum; do \
      git apply --exclude='tests/*' "/tmp/kk/${d}/port.diff"; \
    done

# Verify final tree per-file against the git-blob manifest (a mismatch names
# the exact file). Purge bytecode; the interpreter regenerates it. Rewrite
# the generated version stamp to the string vcs-versioning produces for this
# head (dev counter + 9-hex commit). Keep version/head/chain as build
# provenance next to the base runtime manifest.
RUN set -eux; \
    cd /opt/venv/lib/python3.12/site-packages; \
    sha256sum -c /tmp/kk/manifest.sha256; \
    find vllm -type d -name __pycache__ -prune -exec rm -rf {} +; \
    mkdir -p /opt/venv/share/lil-runtime; \
    cp /tmp/kk/version.txt /tmp/kk/head.txt /tmp/kk/chain.txt /opt/venv/share/lil-runtime/; \
    v="$(cat /tmp/kk/version.txt)"; h="$(cat /tmp/kk/head.txt)"; \
    d="${v#*.dev}"; d="${d%%+*}"; s="${v##*+g}"; \
    printf '%s\n' \
      '# file generated by Dockerfile.vllm-kk (not vcs-versioning)' \
      '__all__ = ["__version__", "__version_tuple__", "version", "version_tuple", "commit_id", "__commit_id__"]' \
      'version: str' \
      '__version__: str' \
      '__version_tuple__: tuple[int | str, ...]' \
      'version_tuple: tuple[int | str, ...]' \
      'commit_id: str | None' \
      '__commit_id__: str | None' \
      "__version__ = version = '${v}'" \
      "__version_tuple__ = version_tuple = (0, 1, 'dev${d}', 'g${s}')" \
      "__commit_id__ = commit_id = 'g${s}'" \
      > vllm/_version.py; \
    rm -rf /tmp/kk

# Import smoke (CPU only). Scheduler/connector modules import headless
# (same set as the unit farm); GPU/Triton-dependent modules byte-compile
# only (house pattern, cf. build/Dockerfile.vllm-fn-tip-20260918).
RUN set -eux; \
    SP=/opt/venv/lib/python3.12/site-packages; \
    /opt/venv/bin/python -c "import vllm; from vllm._version import version as _v; import pathlib; assert _v == pathlib.Path('/opt/venv/share/lil-runtime/version.txt').read_text().strip(), _v"; \
    /opt/venv/bin/python -c 'import importlib; [importlib.import_module(x) for x in ("vllm.entrypoints.openai.chat_completion.protocol","vllm.entrypoints.openai.completion.protocol","vllm.config.speculative","vllm.distributed.kv_transfer.kv_connector.v1.offloading.scheduler","vllm.distributed.kv_transfer.kv_connector.v1.offloading_connector","vllm.v1.core.sched.scheduler","vllm.v1.core.kv_cache_manager","vllm.v1.core.single_type_kv_cache_manager","vllm.v1.kv_cache_interface","vllm.v1.simple_kv_offload.manager","vllm.models.qwen3_8_flash_next.config")]'; \
    /opt/venv/bin/python -c 'from vllm.models.qwen3_8_flash_next.config import Qwen3_8FlashNextConfig as C; import inspect; src=inspect.getsource(C.__init__); assert "max_position_embeddings" in src'; \
    /opt/venv/bin/python -m py_compile \
      $SP/vllm/config/vllm.py \
      $SP/vllm/distributed/kv_transfer/kv_connector/v1/base.py \
      $SP/vllm/distributed/kv_transfer/kv_connector/v1/multi_connector.py \
      $SP/vllm/distributed/kv_transfer/kv_connector/v1/offloading/worker.py \
      $SP/vllm/model_executor/layers/mamba/abstract.py \
      $SP/vllm/models/glm5next/model_state.py \
      $SP/vllm/models/qwen3_8_flash_next/config.py \
      $SP/vllm/models/qwen4_exp/nvidia/model_state.py \
      $SP/vllm/v1/worker/gpu/boundary_checkpoint.py \
      $SP/vllm/v1/worker/gpu/model_states/interface.py
