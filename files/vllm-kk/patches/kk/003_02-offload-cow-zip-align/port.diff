From b8d279785be80c41b323374a135528c1c4ef99a8 Mon Sep 17 00:00:00 2001
From: Carlos Augusto <mb@lab.how>
Date: Wed, 23 Sep 2026 14:08:24 -0600
Subject: [PATCH] [KV Connector] Keep group store ranges aligned across skipped
 CoW groups

OffloadingConnectorScheduler._build_store_jobs builds group_store_ranges, one
(start_chunk_idx, num_chunks) per KV cache group, by zipping
config.kv_group_configs with req_status.group_states. A group whose spec is
MambaSpec with mamba_cache_mode == "align" sets requires_cow_source=True and
was skipped with a bare continue before the append, so those groups got no
entry. The consumer then zips kv_group_configs (N) x group_states (N) x
group_store_ranges (N minus the CoW count): zip truncates to the shortest, so
group_sizes is built with the wrong length and every surviving group's chunk
range is paired with the wrong group.

The worker (vllm/v1/kv_offload/cpu/gpu_worker.py, transfer_async) asserts
len(group_sizes) == len(self.layer_refs_per_group) and EngineCore dies. On
Qwen3.8-Flash-Next (50 KV cache groups, 13 align-mode Mamba) the scheduler
emits 37-entry group_sizes against the worker's 50-entry
layer_refs_per_group, so the first request large enough to complete an
offloadable chunk (~15k tokens) crashes the engine. This is why the complex
connector cannot serve hybrid align-mode Mamba models at all.

Fix: append a (0, 0) placeholder for CoW groups instead of a bare continue, so
group_store_ranges stays one entry per group and positionally aligned. The
consumer's inner loop over offload_keys[0:0] is empty and contributes a 0 at
that position, which is correct: CoW groups persist through the boundary /
partial-tail store paths, not the chunk path. The now-dead second
`if group_config.requires_cow_source: continue` after the append is removed.
The sibling builders (_build_aligned_boundary_store_jobs,
_build_partial_tail_store_jobs) already build group_sizes as [0] * num_groups
and are unaffected.

Also assert at the _build_store_jobs producer exit that every KV group
contributes exactly one store range, so a future pre-append continue names
itself at the source instead of firing the worker's distant length assert.

Live only under the complex OffloadingConnector; inert under
SimpleCPUOffloadConnector, which does not use this scheduler.
---
 .../kv_connector/v1/offloading/scheduler.py   | 20 ++++++++++++++++---
 1 file changed, 17 insertions(+), 3 deletions(-)

diff --git a/vllm/distributed/kv_transfer/kv_connector/v1/offloading/scheduler.py b/vllm/distributed/kv_transfer/kv_connector/v1/offloading/scheduler.py
index 8e5f6ccf16..521f8b4a15 100644
--- a/vllm/distributed/kv_transfer/kv_connector/v1/offloading/scheduler.py
+++ b/vllm/distributed/kv_transfer/kv_connector/v1/offloading/scheduler.py
@@ -1573,6 +1573,16 @@ class OffloadingConnectorScheduler:
                 )
 
                 if group_config.requires_cow_source:
+                    # CoW (mamba align-mode) groups are persisted through the
+                    # boundary / partial-tail store path, not the chunk path.
+                    # Append a (0, 0) placeholder rather than a bare continue so
+                    # group_store_ranges stays positionally aligned with
+                    # kv_group_configs. The consumer zip below pairs each range
+                    # with its own group; a shorter list truncates group_sizes
+                    # AND misaligns every surviving group's chunk range, which
+                    # trips the worker assert
+                    # len(group_sizes) == len(layer_refs_per_group).
+                    group_store_ranges.append((0, 0))
                     continue
 
                 start_chunk_idx = group_state.next_stored_chunk_idx
@@ -1613,9 +1623,6 @@ class OffloadingConnectorScheduler:
                     start_chunk_idx = min(start_chunk_idx, partial_segment_start_chunk)
                 group_store_ranges.append((start_chunk_idx, num_chunks))
 
-                if group_config.requires_cow_source:
-                    continue
-
                 if num_chunks <= start_chunk_idx:
                     continue
                 offload_keys = group_state.offload_keys[start_chunk_idx:num_chunks]
@@ -1682,6 +1689,13 @@ class OffloadingConnectorScheduler:
                         continue
                     new_offload_keys.append(offload_key)
 
+            assert len(group_store_ranges) == len(self.config.kv_group_configs), (
+                "every KV group must contribute exactly one store range; a "
+                "pre-append continue would silently truncate the consumer "
+                "zip and misalign group_sizes for the worker, whose own "
+                "assert is far from the cause"
+            )
+
             if not new_offload_keys:
                 req_status.advance_stored_idx(num_offloadable_tokens)
                 continue
-- 
