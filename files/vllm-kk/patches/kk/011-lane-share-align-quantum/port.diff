From 850215bbbcee1328c910911d90dee431247e2a29 Mon Sep 17 00:00:00 2001
Date: Sat, 17 Oct 2026 18:57:15 -0600
Subject: [PATCH] Floor prefill-lane share to align quantum

With more lane candidates than lanes in mamba "align" cache mode, the
interleave token-budget fanout split gives every running chunk a share
below the block align quantum (ceil(6019/3) = 2007 < the production
quantum 3008). The aligned split floors such a chunk to zero tokens,
which consumes the lane (mark_unavailable) before the allocator is
reached, so neither progress nor the no-progress preemption fallback
is reachable; the doomed async candidates that inflate the fanout
never leave the lanes and the engine spins on empty steps forever.

The lane share now falls back to the global step budget whenever the
budget can cover a full quantum: a lane held by a candidate that
cannot run no longer taxes a runnable chunk (work-conserving - the
first chunk takes whole quanta, later chunks get the remainder). The
share cap, and this relaxation, exist only under the prefill-interleave
step, so lanes == 1 scheduling is bit-identical.

Regression test: tests/v1/core/test_prefill_lane_livelock.py
(test_lane_share_below_align_quantum_cannot_starve_chunk).
---
 tests/v1/core/test_prefill_lane_livelock.py | 91 +++++++++++++++++++++
 vllm/v1/core/sched/scheduler.py             | 22 +++--
 2 files changed, 108 insertions(+), 5 deletions(-)

diff --git a/tests/v1/core/test_prefill_lane_livelock.py b/tests/v1/core/test_prefill_lane_livelock.py
index ee6bc3dd73..84b94c12f6 100644
--- a/tests/v1/core/test_prefill_lane_livelock.py
+++ b/tests/v1/core/test_prefill_lane_livelock.py
@@ -15,6 +15,11 @@ then preempted keep their last_scheduled_step lane rank. That rank must
 age out, and the post-waiting interleave pass must be able to preempt on
 a step that scheduled nothing (only while the connector is quiescent),
 or the frozen-rank pair starves the running chunks forever at free == 0.
+
+With mamba "align" cache mode, a lane share below the block align
+quantum zeroes the chunk in the aligned split before the allocator is
+reached: doomed lane candidates must not fan the token budget out below
+the quantum, or no chunk can ever advance.
 """
 
 import pytest
@@ -386,3 +391,89 @@ def test_busy_connector_guards_preemption_and_aging_recovers():
         "expected recovery through preemption in the preempt-capable "
         "first running pass"
     )
+
+
+def test_lane_share_below_align_quantum_cannot_starve_chunk():
+    """A fanout share below the align quantum must not zero the chunk.
+
+    In a mamba "align" deployment (production quantum 3008, 64
+    here) a chunk whose share ends before the next block boundary is
+    floored to zero tokens by the aligned split, consumes its lane, and
+    never reaches the allocator. With more lane candidates than lanes,
+    every chunk's fanout share falls below the quantum and no prefill
+    can advance while doomed async candidates hold lanes and fail the
+    full-sequence admission gate: empty steps forever. The lane share
+    must fall back to the global step budget whenever that budget can
+    cover a full quantum.
+    """
+    scheduler = create_scheduler(
+        max_num_seqs=16,
+        max_num_batched_tokens=131,  # 2 * 64 + 3: two full quanta per step
+        max_model_len=1024,
+        max_parallel_prefills=4,
+        num_blocks=11,
+        block_size=64,
+        enable_prefix_caching=False,
+        use_kv_connector=mock_kv(matched_tokens=0, is_async=True),
+    )
+    # The scheduler-side flag of a mamba "align" deployment (derived at
+    # construction from has_mamba_layers and mamba_cache_mode == "align").
+    scheduler.need_mamba_block_aligned_split = True
+
+    def fake_lookup(request, num_computed_tokens):
+        if request.request_id == "chunk":
+            return 0, False
+        # Whole-prompt CPU-tier hit: the async admission gate pays the
+        # full-sequence requirement (8 blocks) and must fail against
+        # free (6) minus the chunk's remaining-block reservation (4).
+        return 240, True
+
+    assert scheduler.connector is not None
+    scheduler.connector.get_num_new_matched_tokens = fake_lookup
+
+    (chunk,) = create_requests(
+        num_requests=1,
+        num_tokens=512,
+        req_ids=["chunk"],
+        block_size=64,
+    )
+    scheduler.add_request(chunk)
+    # Advance to a block-aligned mid-prefill position with two full
+    # quanta pending (the aligned split floors every step to 128 here).
+    while chunk.num_computed_tokens < 256:
+        output = scheduler.schedule()
+        assert output.total_num_scheduled_tokens > 0
+        scheduler.update_from_output(
+            output, _partial_prefill_output(list(output.num_scheduled_tokens))
+        )
+    assert chunk.is_prefill_chunk
+
+    for req_id in ("d1", "d2"):
+        (doomed,) = create_requests(
+            num_requests=1,
+            num_tokens=512,
+            req_ids=[req_id],
+            block_size=64,
+        )
+        scheduler.add_request(doomed)
+
+    # All three candidates hold lanes (4 lanes, 3 candidates), so the
+    # chunk's fanout share is ceil(131/3) = 44 < 64: below the
+    # quantum, the aligned split would zero the chunk and consume the
+    # lane at the zero-token branch. With the share cap dropped, the
+    # chunk takes two full quanta from the step budget.
+    progressed = False
+    for _ in range(64):
+        output = scheduler.schedule()
+        if output.total_num_scheduled_tokens > 0:
+            progressed = True
+            break
+        scheduler.update_from_output(output, _empty_output())
+    assert progressed, (
+        "lane fanout shares below the align quantum zeroed the chunk: "
+        "the lane-selected chunk never reached the allocator and starved "
+        "behind the doomed async candidates"
+    )
+    assert chunk.num_computed_tokens == 384
+    for req_id in ("d1", "d2"):
+        assert scheduler.requests[req_id].status == RequestStatus.WAITING
diff --git a/vllm/v1/core/sched/scheduler.py b/vllm/v1/core/sched/scheduler.py
index a7345fa10a..7b7f727b3e 100644
--- a/vllm/v1/core/sched/scheduler.py
+++ b/vllm/v1/core/sched/scheduler.py
@@ -1102,12 +1102,24 @@ class Scheduler(SchedulerInterface):
                 ):
                     num_new_tokens = self.scheduler_config.long_prefill_token_threshold
                 if request.is_prefill_chunk and prefill_interleave_step is not None:
-                    num_new_tokens = min(
-                        num_new_tokens,
-                        prefill_interleave_step.token_budget(
-                            token_budget, scheduled_prefill_req_ids
-                        ),
+                    lane_share = prefill_interleave_step.token_budget(
+                        token_budget, scheduled_prefill_req_ids
                     )
+                    # Invariant: a lane share must never fall below the
+                    # recurrent-state align quantum - the aligned split
+                    # floors a chunk ending before a block boundary to
+                    # zero tokens, consuming the lane before the
+                    # allocator is reached. When the step budget covers
+                    # a full quantum, drop the share cap so an
+                    # unrunnable lane-holder cannot tax a runnable
+                    # chunk.
+                    if (
+                        self.need_mamba_block_aligned_split
+                        and lane_share < self.cache_config.block_size
+                        and token_budget >= self.cache_config.block_size
+                    ):
+                        lane_share = num_new_tokens
+                    num_new_tokens = min(num_new_tokens, lane_share)
                 num_new_tokens = min(
                     num_new_tokens, token_budget, input_budget - draft_slots
                 )
-- 
