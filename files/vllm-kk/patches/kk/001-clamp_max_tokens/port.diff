diff --git a/tests/entrypoints/openai/test_clamp_max_tokens.py b/tests/entrypoints/openai/test_clamp_max_tokens.py
new file mode 100644
index 0000000000..0ec4ab66b7
--- /dev/null
+++ b/tests/entrypoints/openai/test_clamp_max_tokens.py
@@ -0,0 +1,76 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Unit tests for the clamp_max_tokens request flag.
+
+When set, the renderer must not reserve output tokens from the input cap
+(``TokenizeParams.max_output_tokens`` stays 0) so the early-fail guard only
+checks ``prompt <= max_model_len``; the serving layer's ``get_max_tokens``
+then clamps the requested output to the remaining headroom.
+"""
+
+from unittest.mock import Mock
+
+from vllm.config import ModelConfig
+from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+from vllm.entrypoints.openai.completion.protocol import CompletionRequest
+from vllm.entrypoints.serve.utils.api_utils import get_max_tokens
+
+
+def _model_config() -> Mock:
+    model_config = Mock(spec=ModelConfig)
+    model_config.max_model_len = 262144
+    return model_config
+
+
+def test_completion_clamp_zeroes_output_reservation():
+    cfg = _model_config()
+
+    default = CompletionRequest(model="m", prompt="hi", max_tokens=64000)
+    assert default.build_tok_params(cfg).max_output_tokens == 64000
+
+    clamped = CompletionRequest(
+        model="m", prompt="hi", max_tokens=64000, clamp_max_tokens=True
+    )
+    assert clamped.build_tok_params(cfg).max_output_tokens == 0
+    # The prompt cap must be the full model length so a prompt that fits in
+    # max_model_len passes the renderer guard.
+    assert clamped.build_tok_params(cfg).max_input_tokens == 262144
+
+
+def test_completion_clamp_default_off():
+    cfg = _model_config()
+    req = CompletionRequest(model="m", prompt="hi")
+    assert req.clamp_max_tokens is False
+
+
+def test_chat_clamp_zeroes_output_reservation():
+    cfg = _model_config()
+    messages = [{"role": "user", "content": "hi"}]
+
+    default = ChatCompletionRequest(
+        model="m", messages=messages, max_tokens=64000
+    )
+    assert default.build_tok_params(cfg).max_output_tokens == 64000
+
+    clamped = ChatCompletionRequest(
+        model="m", messages=messages, max_tokens=64000, clamp_max_tokens=True
+    )
+    assert clamped.build_tok_params(cfg).max_output_tokens == 0
+
+    # max_completion_tokens branch must be clamped too.
+    clamped_mct = ChatCompletionRequest(
+        model="m",
+        messages=messages,
+        max_completion_tokens=64000,
+        clamp_max_tokens=True,
+    )
+    assert clamped_mct.build_tok_params(cfg).max_output_tokens == 0
+
+
+def test_get_max_tokens_clamps_to_headroom():
+    # 230000-token prompt, 64000 requested -> clamped to 32144.
+    assert (
+        get_max_tokens(262144, 64000, 230000, {}) == 262144 - 230000
+    )
+    # Requested output below headroom is untouched.
+    assert get_max_tokens(262144, 1000, 230000, {}) == 1000
diff --git a/vllm/entrypoints/openai/chat_completion/protocol.py b/vllm/entrypoints/openai/chat_completion/protocol.py
index 89ecef0177..4250552f19 100644
--- a/vllm/entrypoints/openai/chat_completion/protocol.py
+++ b/vllm/entrypoints/openai/chat_completion/protocol.py
@@ -237,6 +237,15 @@ class ChatCompletionRequest(OpenAIBaseModel):
         "the max_completion_tokens field",
     )
     max_completion_tokens: int | None = None
+    clamp_max_tokens: bool = Field(
+        default=False,
+        description=(
+            "If true, clamp the output budget down to the remaining "
+            "context headroom (max_model_len - prompt length) instead of "
+            "rejecting the request when prompt + max_tokens exceeds "
+            "max_model_len. The prompt is kept whole."
+        ),
+    )
     n: int | None = 1
     presence_penalty: float | None = 0.0
     response_format: AnyResponseFormat | None = None
@@ -651,6 +660,13 @@ class ChatCompletionRequest(OpenAIBaseModel):
             max_output_tokens = self.max_tokens
             max_output_tokens_param = "max_tokens"
 
+        # With clamp_max_tokens the serving layer clamps the output budget to
+        # the remaining context headroom, so the renderer must not reserve
+        # output tokens from the input cap (covers both max_tokens and
+        # max_completion_tokens).
+        if self.clamp_max_tokens:
+            max_output_tokens = 0
+
         return TokenizeParams(
             max_total_tokens=model_config.max_model_len,
             max_output_tokens=max_output_tokens or 0,
diff --git a/vllm/entrypoints/openai/completion/protocol.py b/vllm/entrypoints/openai/completion/protocol.py
index bf0a94eea7..b6d3971e54 100644
--- a/vllm/entrypoints/openai/completion/protocol.py
+++ b/vllm/entrypoints/openai/completion/protocol.py
@@ -59,6 +59,15 @@ class CompletionRequest(OpenAIBaseModel):
     logit_bias: dict[str, float] | None = None
     logprobs: int | None = None
     max_tokens: int | None = 16
+    clamp_max_tokens: bool = Field(
+        default=False,
+        description=(
+            "If true, clamp max_tokens down to the remaining context "
+            "headroom (max_model_len - prompt length) instead of "
+            "rejecting the request when prompt + max_tokens exceeds "
+            "max_model_len. The prompt is kept whole."
+        ),
+    )
     n: int = 1
     presence_penalty: float | None = 0.0
     seed: int | None = Field(None, ge=_INT64_MIN, le=_INT64_MAX)
@@ -263,9 +272,13 @@ class CompletionRequest(OpenAIBaseModel):
     # --8<-- [end:completion-extra-params]
 
     def build_tok_params(self, model_config: ModelConfig) -> TokenizeParams:
+        # With clamp_max_tokens the serving layer clamps max_tokens to the
+        # remaining context headroom, so the renderer must not reserve
+        # output tokens from the input cap.
+        max_output_tokens = 0 if self.clamp_max_tokens else (self.max_tokens or 0)
         return TokenizeParams(
             max_total_tokens=model_config.max_model_len,
-            max_output_tokens=self.max_tokens or 0,
+            max_output_tokens=max_output_tokens,
             truncate_prompt_tokens=self.truncate_prompt_tokens,
             truncation_side=self.truncation_side,
             add_special_tokens=self.add_special_tokens,
